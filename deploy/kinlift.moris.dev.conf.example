# Include this whole file from Nginx's http context (e.g. sites-enabled).
# Do not paste the map blocks inside an existing server block.
# Verify root, certificates and the system CA bundle before enabling.

# Evaluate the final response: an absent hashed asset must never be cached for a year.
map "$status:$uri" $kynlift_cache_control {
    default "no-cache";
    ~^[0-9]+:/__/(auth|firebase)(/|$) "no-store";
    ~^(200|206|304):/assets/ "public, max-age=31536000, immutable";
}

# try_files selects app.html for account routes and 404.html for missing URLs.
# These headers are present even before a crawler executes JavaScript.
map $uri $kynlift_robots {
    default "";
    /app.html "noindex, nofollow";
    /404.html "noindex, nofollow";
    ~^/__/ "noindex, nofollow";
}

# Firebase owns its helpers' document policy. App framing restrictions must not
# block the same-origin iframe used to complete Google sign-in.
map $uri $kynlift_csp {
    default "base-uri 'self'; object-src 'none'; frame-ancestors 'none'";
    ~^/__/(auth|firebase)(/|$) "";
}
map $uri $kynlift_frame_options {
    default "DENY";
    ~^/__/(auth|firebase)(/|$) "";
}

# Keep the server's existing ACME challenge handling when integrating port 80.
server {
    listen 80;
    server_name kinlift.moris.dev;
    location / { return 308 https://kinlift.moris.dev$request_uri; }
}

server {
    listen 443 ssl;
    server_name kinlift.moris.dev;

    ssl_certificate /etc/letsencrypt/live/kinlift.moris.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kinlift.moris.dev/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    root /var/www/kynlift/current;
    index index.html;
    autoindex off;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/manifest+json application/xml image/svg+xml;

    # Keep add_header at this level: location-level add_header would replace the
    # inherited set on Nginx versions older than add_header_inherit (1.29.3).
    add_header Cache-Control $kynlift_cache_control always;
    add_header X-Robots-Tag $kynlift_robots always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header Content-Security-Policy $kynlift_csp always;
    add_header X-Frame-Options $kynlift_frame_options always;

    # Forward both /__/auth and /__/auth/... transparently; preserve GET/POST,
    # query strings and the original URI. Never cache OAuth helper responses.
    location ~ ^/__/(auth|firebase)(/|$) {
        gzip off;
        access_log off;
        proxy_pass https://kynlift.firebaseapp.com;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host kynlift.firebaseapp.com;
        proxy_cache off;
        proxy_intercept_errors off;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
    }

    location = / {
        try_files /index.html =404;
    }

    location = /index.html {
        return 308 /$is_args$args;
    }

    # These files are response bodies, never separate public URLs.
    location = /app.html { internal; }
    location = /404.html { internal; }

    location = /sw.js {
        default_type application/javascript;
        try_files $uri =404;
    }
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        try_files $uri =404;
    }
    location = /robots.txt {
        default_type text/plain;
        try_files $uri =404;
    }
    location = /sitemap.xml {
        default_type application/xml;
        try_files $uri =404;
    }

    # Only known account routes receive the non-indexable app shell.
    # Keep this list aligned with src/App.tsx when adding routes.
    location ~ ^/(allenamento(/sessione|/scheda/[^/]+)?|schede|catalogo|progressi|impostazioni|storico/[^/]+)$ {
        try_files /app.html =404;
    }

    # Never expose repository internals, env files, logs, keys or source maps.
    location ~ /\.(?!well-known(?:/|$)) { return 404; }
    location ~* \.(map|env|log|key|pem)$ { return 404; }

    location /assets/ {
        try_files $uri =404;
    }

    error_page 404 /404.html;
    location / {
        try_files $uri =404;
    }
}
