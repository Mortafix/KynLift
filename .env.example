# Firebase web configuration: these identify your project; never put Admin SDK
# private keys or service-account credentials in VITE_* variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Exact host serving Kynlift (no https:// or trailing slash).
# Configure a transparent /__/auth/ reverse proxy and authorized redirect URI.
# Example: kynlift.example.com
VITE_FIREBASE_AUTH_DOMAIN=

# Enable only AFTER changing Firebase Authentication > Settings > User account
# linking to "Create multiple accounts for each identity provider".
# This prevents Firebase from silently replacing an unverified Gmail password
# account when Google signs in. Linking remains an explicit settings action.
VITE_FIREBASE_EXPLICIT_LINKING=false

# Enable only for the public production release on the URL in site.config.json.
# Keep false for demo/preview/staging builds. Production preflight requires true.
VITE_SITE_INDEXING=false
